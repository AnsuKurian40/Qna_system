0d41\u0d35\u0d47\u0d26\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46, \u0d05\u0d28\u0d41\u0d2c\u0d28\u0d4d\u0d27\u0d19\u0d4d\u0d19\u0d33\u0d3e\u0d2f\u0d3f \u0d2c\u0d4d\u0d30\u0d3e\u0d39\u0d4d\u0d2e\u0d23\u0d19\u0d4d\u0d19\u0d7e, \u0d06\u0d30\u0d23\u0d4d\u0d2f\u0d15\u0d19\u0d4d\u0d19\u0d7e, \u0d09\u0d2a\u0d28\u0d3f\u0d37\u0d24\u0d4d\u0d24\u0d41\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d41\u0d02 \u0d35\u0d47\u0d26 \u0d38\u0d3e\u0d39\u0d3f\u0d24\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2d\u0d3e\u0d17\u0d2e\u0d3e\u0d23\u0d4d. \u0d35\u0d47\u0d26 \u0d15\u0d3e\u0d32\u0d24\u0d4d\u0d24\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d31\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d20\u0d28 \u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d38\u0d4d\u0d30\u0d4b\u0d24\u0d38\u0d4d\u0d38\u0d3e\u0d23\u0d4d \u0d35\u0d47\u0d26\u0d38\u0d3e\u0d39\u0d3f\u0d24\u0d4d\u0d2f\u0d02", "id_": "33f44444-c046-49f2-889a-e169d0afaba1"}, "3563b61d-2e79-40df-aac6-5ea980458659": {"label": "text_chunk", "embedding": null, "properties": {"file_name": "ss_1.docx", "file_path": "/workspace/data/ss_1.docx", "file_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "file_size": 142152, "creation_date": "2026-03-03", "last_modified_date": "2026-03-03", "_node_content": "{\"id_\": \"3563b61d-2e79-40df-aac6-5ea980458659\", \"embedding\": null, \"metadata\": {\"file_name\": \"ss_1.docx\", \"file_path\": \"/workspace/data/ss_1.docx\", \"file_type\": \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\", \"file_size\": 142152, \"creation_date\": \"2026-03-03\", \"last_modified_date\": \"2026-03-03\"}, \"excluded_embed_metadata_keys\": [\"file_name\", \"file_type\", \"file_size\", \"creation_date\", \"last_modified_date\", \"last_accessed_date\"], \"excluded_llm_metadata