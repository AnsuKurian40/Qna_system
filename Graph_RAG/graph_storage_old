, \"metadata\": {}, \"hash\": \"9a50e822f48c2da39eb4233b531c86fad82660b435bc9a048eae1c72cfaabd40\", \"class_name\": \"RelatedNodeInfo\"}}, \"text\": \"\", \"mimetype\": \"text/plain\", \"start_char_idx\": 44570, \"end_char_idx\": 44919, \"text_template\": \"{metadata_str}\\n\\n{content}\", \"metadata_template\": \"{key}: {value}\", \"metadata_seperator\": \"\\n\", \"class_name\": \"TextNode\"}", "_node_type": "TextNode", "document_id": "d2f7a7ac-35a5-42de-b602-da6a9236e43d", "doc_id": "d2f7a7ac-35a5-42de-b602-da6a9236e43d", "ref_doc_id": "d2f7a7ac-35a5-42de-b602-da6a9236e43d"}, "text": "\u0d08 \u0d15\u0d3e\u0d32\u0d18\u0d1f\u0d4d\u0d1f\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d35\u0d4d\u0d2f\u0d3e\u0d2a\u0d3e\u0d30\u0d2a\u0d3e\u0d24\u0d15\u0d7e \u0d35\u0d3f\u0d15\u0d38\u0d3f\u0d1a\u0d4d\u0d1a\u0d41\u0d35\u0d28\u0d4d\u0d28\u0d41. \u0d2e\u0d3f\u0d15\u0d1a\u0d4d\u0d1a \u0d38\u0d4d\u0d35\u0d7c\u0d23\u0d4d\u0d23\u0d28\u0d3e\u0d23\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d35\u0d46\u0d33\u0d4d\u0d33\u0d3f, \u0d1a\u0d46\u0d2e\u0d4d\u0d2a\u0d4d \u0d28\u0d3e\u0d23\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d2a\u0d41\u0d31\u0d24\u0d4d\u0d24\u0d3f\u0d31\u0d15\u0d4d\u0d15\u0d3f. \u0d28\u0d17\u0d30\u0d36\u0d4d\u0d30\u0d47\u0d37\u0d4d\u0d20\u0d3f, \u0d38\u0d3e\u0d7c\u0d25\u0d35\u0d3e\u0d39 \u0d0e\u0d28\u0d4d\u0d28\u0d40 \u0d35\u0d4d\u0d2f\u0d3e\u0d2a\u0d3e\u0d30 \u0d2a\u0d4d\u0d30\u0d2e\u0d41\u0d16\u0d7c\u0d15\u0d4d\u0d15\u0d4d \u0d2d\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d2a\u0d19\u0d4d\u0d15\u0d3e\u0d33\u0d3f\u0d24\u0d4d\u0d24\u0d2e\u0d41\u0d23\u0d4d\u0d1f\u0d3e\u0d2f\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d35\u0d48\u0d36\u0d3e\u0d32\u0d3f, \u0d2a\u0d3e\u0d1f\u0d32\u0d40\u0d2a\u0d41\u0d24\u0d4d\u0d30\u0d02, \u0d15\u0d28\u0d57\u0d1c\u0d4d, \u0d36\u0d4d\u0d30\u0d3e\u0d35\u0d38\u0d4d\u0d24\u0d3f, \u0d15\u0d57\u0d38\u0d3e\u0d02\u0d2c\u0d3f, \u0d09\u0d1c\u0d4d\u0d1c\u0d2f\u0d3f\u0d28\u0d3f, \u0d2e\u0d25\u0d41\u0d30 \u0d2e\u0d41\u0d24\u0d32\u