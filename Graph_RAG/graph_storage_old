\u0d24\u0d15 \u0d38\u0d02\u0d18\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d46 \u0d2a\u0d4d\u0d30\u0d2e\u0d41\u0d16\u0d30\u0d3e \u0d2f\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41 \u0d07\u0d15\u0d4d\u0d15\u0d42\u0d1f\u0d4d\u0d1f\u0d7c.\n\n\n\n\u0d35\u0d4d\u0d2f\u0d3e\u0d2a\u0d3e\u0d30\u0d35\u0d41\u0d02 \u0d35\u0d3e\u0d23\u0d3f\u0d1c\u0d4d\u0d2f\u0d35\u0d41\u0d02\n\n\u0d17\u0d41\u0d2a\u0d4d\u0d24\u0d15\u0d3e\u0d32\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d24\u0d41\u0d1f\u0d15\u0d4d\u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d06\u0d2d\u0d4d\u0d2f\u0d28\u0d4d\u0d24\u0d30\u0d35\u0d3e\u0d23\u0d3f\u0d1c\u0d4d\u0d2f\u0d02 \u0d35\u0d33\u0d30\u0d46 \u0d35\u0d3f\u0d2a\u0d41\u0d32\u0d2e\u0d3e\u0d2f\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d15\u0d43\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d41\u0d31\u0d2e\u0d46 \u0d35\u0d3f\u0d35\u0d3f\u0d27 \u0d15\u0d48\u0d24\u0d4d\u0d24\u0d4a\u0d34\u0d3f\u0d32\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d15\u0d30\u0d15\u0d57\u0d36\u0d32 \u0d28\u0d3f\u0d7c\u0d2e\u0d4d\u0d2e\u0d3e\u0d23\u0d35\u0d41\u0d02 \u0d28\u0d3f\u0d32\u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d3f\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d2f\u0d3f \u0d2a\u0d1f\u0d4d\u0d1f\u0d3f\u0d15\u0d2f\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d2e\u0d28\u0d38\u0d4d\u0d38\u0d3f\u0d32\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d32\u0d4d\u0d32\u0d4b.", "id_": "650b1db8-7e72-43d3-a21b-47902b9c009b"}, "43dd6830-36b1-4abb-a1e2-c8eb6f769183": {"label": "text_chunk", "embedding": null, "properties": {"file_name": "ss_1.docx", "file_path": "/workspace/data/ss_1.docx", "file_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "file_size": 142152, "creation_date": "2026-03-03", "last_modified_date": "2026-03-03", "_node_content": "{\"id_\": \"43dd6830-36b1-4abb-a1e2-c8eb6f769183\", \"embedding\": null, \"metadata\": {\"file_name\": \"ss_1.docx\", \"file_path\": \"/workspace/data/ss_1.docx\", \"file_type\": \"application/vnd.openxmlformats-officedocument.wordprocessingml.doc