2f\u0d2e\u0d3e\u0d2f \u0d15\u0d32\u0d4d\u0d32\u0d41\u0d15\u0d33\u0d46 \u0d30\u0d42\u0d2a\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d02 \u0d35\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d3e\u0d24\u0d46 \u0d24\u0d28\u0d4d\u0d28\u0d46 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d30\u0d40\u0d24\u0d3f\n\n\u0d30\u0d42\u0d2a\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d02 \u0d35\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d7d (Fashioning): \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f \u0d15\u0d32\u0d4d\u0d32\u0d41\u0d15\u0d33\u0d46 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d3e\u0d28\u0d41\u0d38\u0d30\u0d23\u0d02 \u0d30\u0d42\u0d2a\u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d02 \u0d35\u0d30\u0d41\u0d24\u0d4d\u0d24\u0d3f \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d30\u0d40\u0d24\u0d3f\n\n\u0d15\u0d4d\u0d30\u0d2e\u0d35\u0d7d\u0d15\u0d4d\u0d15\u0d30\u0d23\u0d02(Standardization): \u0d13\u0d30\u0d4b \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d24\u0d4d\u0d2f\u0d47\u0d15\u0d24\u0d30\u0d02 \u0d09\u0d2a\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e", "id_": "62a9396f-eba3-4375-bbe0-01a6b6aedc60"}, "dab105f9-5cbe-43e1-9bb5-f658b19daedc": {"label": "text_chunk", "embedding": null, "properties": {"file_name": "ss_1.docx", "file_path": "/workspace/data/ss_1.docx", "file_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "file_size": 142152, "creation_date": "2026-03-03", "last_modified_date": "2026-03-03", "_node_content": "{\"id_\": \"dab105f9-5cbe-43e1-9bb5-f658b19daedc\", \"embedding\": null, \"metadata\": {\"file_name\": \"ss_1.docx\", \"file_path\": \"/workspace/data/ss_1.docx\", \"file_type\": \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\", \"file_size\": 142152, \"creation_date\": \"2026-03-03\", \"last_modified_date\": \"2026-03-03\"}, \"excluded_embed_metadata_keys\": [\"file_name\", \"file_type\", \"file_size\", \"creation_date\", \"last_modified_date\", \"last_