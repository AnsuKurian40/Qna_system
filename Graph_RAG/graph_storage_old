\u0d31\u0d19\u0d4d\u0d19\u0d3f\u0d2f \"\u0d28\u0d3e\u0d37\u0d23\u0d7d \u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u0d15\u0d7d \u0d13\u0d2b\u0d40\u0d38\u0d3f\u0d28\u0d4d\u0d31\u0d46 (NSO), \u0d35\u0d3f\u0d2e\u0d7a \u0d06\u0d7b\u0d21\u0d4d \u0d2e\u0d46\u0d7b \u0d07\u0d7b \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f \u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d \u0d05\u0d28\u0d41\u0d38\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d 2015-19 \u0d15\u0d3e\u0d32\u0d2f\u0d33\u0d35\u0d3f\u0d7d \u0d07\u0d28\u0d4d\u0d24\u0d4d\u0d2f\u0d2f\u0d3f\u0d32\u0d46 \u0d38\u0d4d\u0d24\u0d4d\u0d30\u0d40-\u0d2a\u0d41\u0d30\u0d41\u0d37 \u0d06\u0d2f\u0d41\u0d7c\u0d26\u0d48\u0d7c\u0d18\u0d4d\u0d2f\u0d02 \u0d2f\u0d25\u0d3e\u0d15\u0d4d\u0d30\u0d2e\u0d02 71.1 \u0d09\u0d02, 68.4 \u0d09\u0d02 \u0d06\u0d23\u0d4d. \u0d05\u0d24\u0d47\u0d38\u0d2e\u0d2f\u0d02 \u0d15\u0d47\u0d30\u0d33\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d38\u0d4d\u0d24\u0d4d\u0d30\u0d40-\u0d2a\u0d41\u0d30\u0d41\u0d37 \u0d06\u0d2f\u0d41\u0d7c\u0d26\u0d48\u0d7c\u0d18\u0d4d\u0d2f\u0d02 78.0 \u0d09\u0d02 72.3-\u0d09\u0d02 \u0d06\u0d23\u0d4d.", "id_": "ca13b74a-b872-4289-a93e-b70ba2b85a3c"}, "7f0c3b79-b823-406d-b0a3-6419b025e1e2": {"label": "text_chunk", "embedding": null, "properties": {"file_name": "ss_1.docx", "file_path": "/workspace/data/ss_1.docx", "file_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "file_size": 142152, "creation_date": "2026-03-03", "last_modified_date": "2026-03-03", "_node_content": "{\"id_\": \"7f0c3b79-b823-406d-b0a3-6419b025e1e2\", \"embedding\": null, \"metadata\": {\"file_name\": \"ss_1.docx\", \"file_path\": \"/workspace/data/ss_1.docx\", \"file_type\": \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\", \"file_size\": 142152, \"creation_date\": \"2026-03-03\", \"last_modified_date\": \"2026-03-03\"}, \"excluded_embed_metadata_keys\": [\"file_name\", \"file_type\", \"file_size\", \