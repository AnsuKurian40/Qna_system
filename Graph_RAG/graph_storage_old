d26\u0d02 \u0d30\u0d42\u0d2a\u0d02\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d24\u0d4d.\n\n\u0d06\u0d26\u0d3f\u0d2e\u0d2e\u0d28\u0d41\u0d37\u0d4d\u0d2f\u0d30\u0d41\u0d1f\u0d46 \u0d1c\u0d40\u0d35\u0d28\u0d4b\u0d2a\u0d3e\u0d27\u0d3f\u0d15\u0d33\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2c\u0d28\u0d4d\u0d27\u0d2e\u0d41\u0d33\u0d4d\u0d33\u0d24\u0d3e\u0d23\u0d4d \u0d09\u0d2a\u0d15\u0d30\u0d23 \u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d28\u0d3f\u0d7c\u0d2e\u0d4d\u0d2e\u0d3e\u0d23\u0d02.", "id_": "a3f1046e-3af8-44ca-95fd-e9b52152eb8b"}, "62a9396f-eba3-4375-bbe0-01a6b6aedc60": {"label": "text_chunk", "embedding": null, "properties": {"file_name": "ss_1.docx", "file_path": "/workspace/data/ss_1.docx", "file_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "file_size": 142152, "creation_date": "2026-03-03", "last_modified_date": "2026-03-03", "_node_content": "{\"id_\": \"62a9396f-eba3-4375-bbe0-01a6b6aedc60\", \"embedding\": null, \"metadata\": {\"file_name\": \"ss_1.docx\", \"file_path\": \"/workspace/data/ss_1.docx\", \"file_type\": \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\", \"file_size\": 142152, \"creation_date\": \"2026-03-03\", \"last_modified_date\": \"2026-03-03\"}, \"excluded_embed_metadata_keys\": [\"file_name\", \"file_type\", \"file_size\", \"creation_date\", \"last_modified_date\", \"last_accessed_date\"], \"excluded_llm_metadata_keys\": [\"file_name\", \"file_type\", \"file_size\", \"creation_date\", \"last_modified_date\", \"last_accessed_date\"], \"relationships\": {\"1\": {\"node_id\": \"d2f7a7ac-35a5-42de-b602-da6a9236e43d\", \"node_type\": \"4\", \"metadata\": {\"file_name\": \"ss_1.docx\", \"file_path\": \"/workspace/data/ss_1.docx\", \"file_type\": \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\", \"file_size\": 142152, \"creation_date\": \"2026-03-03\", \"last_modified_date\": \"2026-03-03\"}, \"hash\": \"6585bc4d1bd81596d3989f15d71f5573fab0a21004013ba4bf3d274411bfd7a1\", \"